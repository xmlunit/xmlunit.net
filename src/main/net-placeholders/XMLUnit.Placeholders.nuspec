<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>XMLUnit.Placeholders</id>
    <version>$version$</version>
    <title>XMLUnit Placeholders</title>
    <authors>XMLUnit Contributors</authors>
    <owners />
    <projectUrl>https://www.xmlunit.org/</projectUrl>
    <license type="expression">Apache-2.0</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>This package contains experimental support for
    configuring parts of the test engine by using ${xmlunit.KEYWORD}
    sequences inside the control document.</description>
    <summary>Experimental Placeholders Support for XMLUnit.NET</summary>
    <dependencies>
      <dependency id="XMLUnit.Core" version="[$version$]" />
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Xml" />
    </frameworkAssemblies>
    <tags>xmlunit xml unit-testing test xmldiff</tags>
    <readme>docs\README.md</readme>
  </metadata>
  <files>
    <file src="..\..\..\build/NetFramework/bin/Release/xmlunit-placeholders.dll" target="lib\net35"/>
    <file src="..\..\..\build/NetFramework/bin/Release/xmlunit-placeholders.pdb" target="lib\net35"/>
    <file src="..\..\..\build/NetFramework/bin/Release/xmlunit-placeholders.xml" target="lib\net35"/>
    <file src="..\..\..\build/bin/Release/netstandard2.0/xmlunit-placeholders.dll" target="lib\netstandard2.0"/>
    <file src="..\..\..\build/bin/Release/netstandard2.0/xmlunit-placeholders.xml" target="lib\netstandard2.0"/>
    <file src="..\..\doc/readmes/net-placeholders/README.md" target="docs"/>
  </files>
</package>
